// TCP accept/connect stress (Sonite source).
// Run: sn run examples/stress/net-tls-stress.sn

import { TcpListener, TcpStream } from "std/net";
import { spawn } from "std/async";

async function client(port: i32): void {
    for (let i = 0; i < 20; i++) {
        let conn = await TcpStream.connect("127.0.0.1", port);
        await conn.write(Bytes.fromString("ping"));
        await conn.close();
    }
}

async function main(): void {
    let port: i32 = 19041;
    let listener = await TcpListener.bind("127.0.0.1", port);
    let c = spawn(client(port));
    for (let i = 0; i < 20; i++) {
        let server = await listener.accept();
        let _msg = await server.read();
        await server.close();
    }
    await c;
    listener.close();
    print("net_stress ok");
}

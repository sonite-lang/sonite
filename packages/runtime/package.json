{
  "name": "@sonite/runtime",
  "version": "1.0.0",
  "description": "C runtime library for sonite programs",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "include",
    "prebuilt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "openssl": "node scripts/fetch-openssl.js",
    "build": "tsc -p tsconfig.build.json && make && node ./dist/install-prebuilt.js",
    "clean": "rm -rf dist && make clean",
    "test": "make test",
    "test:stress": "make test-stress",
    "test:asan": "make test-asan",
    "test:ubsan": "make test-ubsan",
    "test:lsan": "make test-lsan",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prebuilt:install": "tsc -p tsconfig.build.json && node ./dist/install-prebuilt.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ethan-davies/sonite.git",
    "directory": "packages/runtime"
  },
  "bugs": {
    "url": "https://github.com/ethan-davies/sonite/issues"
  },
  "homepage": "https://github.com/ethan-davies/sonite/tree/main/packages/runtime"
}

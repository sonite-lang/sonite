{
  "name": "@sonite/std",
  "version": "1.0.0",
  "description": "Standard library for sonite (.sn sources)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ethan-davies/sonite.git",
    "directory": "packages/std"
  },
  "bugs": {
    "url": "https://github.com/ethan-davies/sonite/issues"
  },
  "homepage": "https://github.com/ethan-davies/sonite/tree/main/packages/std"
}
